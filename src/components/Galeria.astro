---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props { slug: string; titulo: string }
const { slug, titulo } = Astro.props;

const todas = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/fotos/**/*.jpg',
  { eager: true },
);

const fotos = Object.entries(todas)
  .filter(([ruta]) => ruta.startsWith(`/src/assets/fotos/${slug}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([ruta, modulo]) => ({
    imagen: modulo.default,
    // El texto alternativo sale del nombre del archivo
    alt: `${titulo}: ${ruta.split('/').pop()!.replace('.jpg', '').replaceAll('-', ' ')}`,
  }));
---
{fotos.length === 0 && <p>Muy pronto habrá fotografías en esta sección.</p>}
<div class="galeria">
  {fotos.map(({ imagen, alt }) => (
    <a href={imagen.src}>
      <Image
        src={imagen}
        alt={alt}
        widths={[400, 800, 1200]}
        sizes="(max-width: 640px) 100vw, 33vw"
      />
    </a>
  ))}
</div>

<style>
  .galeria { columns: 3 18rem; column-gap: 1rem; }
  .galeria a { display: block; margin-bottom: 1rem; break-inside: avoid; }
  .galeria img { display: block; width: 100%; height: auto; }
</style>
